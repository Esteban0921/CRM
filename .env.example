# apps/api
API_PORT=8000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://crm:crm@localhost:5432/crm_transporte
REDIS_URL=redis://localhost:6379
JWT_SECRET=
JWT_EXPIRES_MINUTES=15

# Gmail ingestion (Fase 2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_WATCH_LABEL=AUTO/PENDING

# Email saliente / notificaciones (Fase 4) — Mailpit en desarrollo
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@crm-transporte.local

# Escaneo de adjuntos (RULE-016) — daemon clamd, servicio `clamav` en docker-compose.yml
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Carpeta donde se guardan los adjuntos ingeridos (POST /ingestion/run)
ATTACHMENTS_DIR=./data/attachments

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:8000
E2E_PORT=4123
