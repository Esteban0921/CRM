# apps/api
# APP_ENV=production aborta el arranque si JWT_SECRET sigue siendo el de
# desarrollo o mide menos de 32 caracteres (TASK-0088).
APP_ENV=development
API_PORT=8000
# Lista separada por comas. Sin 127.0.0.1 no se puede abrir la web por esa
# direccion ni probarla desde un movil de la red local (TASK-0141).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 127.0.0.1 y no localhost: localhost resuelve primero a ::1, donde Docker no
# publica nada, y cada conexion espera el timeout de IPv6 (TASK-0181).
DATABASE_URL=postgresql+psycopg://crm:crm@127.0.0.1:5432/crm_transporte
REDIS_URL=redis://127.0.0.1:6379
# Generalo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=15
# Bloqueo de fuerza bruta en /auth/login (TASK-0094)
LOGIN_MAX_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW_SECONDS=300

# Gmail ingestion (Fase 2)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_WATCH_LABEL=AUTO/PENDING

# Email saliente / notificaciones (Fase 4) — Mailpit en desarrollo
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=no-reply@crm-transporte.local

# Escaneo de adjuntos (RULE-016) — daemon clamd, servicio `clamav` en docker-compose.yml
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Carpeta donde se guardan los adjuntos ingeridos (POST /ingestion/run)
ATTACHMENTS_DIR=./data/attachments
# Limites de recursos de la ingesta (RULE-016, TASK-0090)
MAX_ATTACHMENT_BYTES=10485760
MAX_ATTACHMENTS_PER_EMAIL=20
MAX_EXTRACTION_TEXT_BYTES=262144

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:8000
E2E_PORT=4123
